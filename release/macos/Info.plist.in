<?xml version="1.0" encoding="UTF-8"?>
<!-- Bundle Info.plist for the Kameraa macOS app. CMake substitutes the
     @MACOSX_BUNDLE_*@ values from the app target properties at generate time. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>@MACOSX_BUNDLE_BUNDLE_NAME@</string>
    <key>CFBundleDisplayName</key>
    <string>Kameraa</string>
    <key>CFBundleExecutable</key>
    <string>kameraa</string>
    <key>CFBundleIdentifier</key>
    <string>@MACOSX_BUNDLE_GUI_IDENTIFIER@</string>
    <key>CFBundleVersion</key>
    <string>@MACOSX_BUNDLE_BUNDLE_VERSION@</string>
    <key>CFBundleShortVersionString</key>
    <string>@MACOSX_BUNDLE_SHORT_VERSION_STRING@</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.3</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Required to access the camera on macOS. -->
    <key>NSCameraUsageDescription</key>
    <string>Kameraa needs camera access to capture and enhance your webcam feed.</string>
</dict>
</plist>
